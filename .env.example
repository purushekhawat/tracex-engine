# ==========================================
# TRACE-X Environment Configuration Template
# SIH 26182 - Explainable Cross-Chain VASP Attribution Engine
# ==========================================

# Environment & Server
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
FRONTEND_URL=http://localhost:5173
JWT_SECRET=tracex_super_secret_jwt_key_sih2026_change_in_production

# Synthetic / Mock Data Provider Settings (Set to true for dev/offline demo)
USE_SYNTHETIC_DATA=true
MOCK_BLOCKCHAIN_DELAY_MS=300

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tracex
POSTGRES_PASSWORD=tracex_secret_password
POSTGRES_DB=tracex_db
POSTGRES_SSLMODE=disable

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracex_neo4j_secret

# Redis Cache & Task Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python Graph Analytics & Risk Microservice
ANALYTICS_SERVICE_URL=http://localhost:5000

# Blockchain Explorer & Intelligence APIs (Production API Keys)
# Ethereum (Etherscan / Infura / Alchemy)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# TRON (TronGrid / Trongrid API Key)
TRONGRID_API_KEY=your_trongrid_api_key_here
TRON_RPC_URL=https://api.trongrid.io

# Chain-Agnostic Extensibility (Future Chains)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
POLYGONSCAN_API_KEY=your_polygonscan_key_here
BSCSCAN_API_KEY=your_bscscan_key_here

# SAHYOG Integration Abstraction Layer (LEA Inter-Agency System)
SAHYOG_MOCK_ENDPOINT=http://localhost:8080/api/v1/sahyog/mock
SAHYOG_API_KEY=sahyog_dev_token_sample
